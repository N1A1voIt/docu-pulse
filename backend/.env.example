# Backend (Fastify) environment variables
# Copy to .env and fill in real values. Never commit real secrets.

# Runtime
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docupulse

# Client / CORS
CLIENT_ORIGIN=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
# Public backend URL (used for OAuth callbacks). Defaults to http://localhost:$PORT.
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated trusted origins (defaults to CLIENT_ORIGIN).
TRUSTED_ORIGINS=http://localhost:3000

# Proxy / TLS awareness (set to "true" or number of trusted proxy hops behind TLS termination)
TRUST_PROXY=false

# Edge rate limiting for /api/auth/* (stricter)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# General API rate limiting (higher)
# RATE_LIMIT_API_MAX=1000
# RATE_LIMIT_API_WINDOW_MS=60000

# Enabled providers (comma-separated: google,github,microsoft)
AUTH_PROVIDERS=google,github,microsoft

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Entra ID (tenantId defaults to "common")
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common